<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AMApplicationBuild</key>
	<string>534</string>
	<key>AMApplicationVersion</key>
	<string>2.10</string>
	<key>AMDocumentVersion</key>
	<string>2</string>
	<key>actions</key>
	<array>
		<dict>
			<key>action</key>
			<dict>
				<key>AMAccepts</key>
				<dict>
					<key>Container</key>
					<string>List</string>
					<key>Optional</key>
					<true/>
					<key>Types</key>
					<array>
						<string>com.apple.cocoa.string</string>
					</array>
				</dict>
				<key>AMActionVersion</key>
				<string>2.0.3</string>
				<key>AMApplication</key>
				<array>
					<string>Automator</string>
				</array>
				<key>AMParameterProperties</key>
				<dict>
					<key>COMMAND_STRING</key>
					<dict/>
					<key>CheckedForUserDefaultShell</key>
					<dict/>
					<key>inputMethod</key>
					<dict/>
					<key>shell</key>
					<dict/>
					<key>source</key>
					<dict/>
				</dict>
				<key>AMProvides</key>
				<dict>
					<key>Container</key>
					<string>List</string>
					<key>Types</key>
					<array>
						<string>com.apple.cocoa.string</string>
					</array>
				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/bash
# Called by the Finder context menu (Automator Quick Action "Créer un PDF").
# Merges the selected PDFs and images, in selection order (Finder hands "$@" in click
# order, checked by Michael 2026-10-20), into one PDF next to the first file, without
# losing anything: qpdf copies PDF pages byte for byte, img2pdf embeds JPEG and PNG as
# they are and stores other images losslessly. The result gets the oldest creation date and the oldest
# modification date of the sources, on the file (Finder) and inside the PDF.
export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
QPDF="${QPDF:-/opt/homebrew/bin/qpdf}"
IMG2PDF="${IMG2PDF:-/opt/homebrew/bin/img2pdf}"

# Messages travel as osascript arguments, never inside the AppleScript text.
warn() {
  osascript - "$1" &lt;&lt;'AS' &gt;/dev/null
on run argv
  activate
  display dialog (item 1 of argv) buttons {"OK"} default button "OK" with icon caution with title "Créer un PDF"
end run
AS
}
fail() { warn "$1"$'\n\nAucun PDF créé.'; exit 1; }

[ "$#" -eq 0 ] &amp;&amp; exit 0
for t in "$QPDF" "$IMG2PDF"; do
  [ -x "$t" ] || fail "$(basename "$t") est introuvable. Dans le Terminal : brew install qpdf img2pdf"
done
# img2pdf's own Python (from its first line) also runs the Pillow snippet below.
PY=$(sed -n '1s/^#! *//p' "$IMG2PDF")
[ -x "$PY" ] || fail "Python d'img2pdf introuvable ($PY). Dans le Terminal : brew reinstall img2pdf"
# First bytes as hex: the content says what a file is, whatever its name.
magic() { od -An -tx1 -N4 "$1" | tr -d ' \n'; }
deep() { grep -q -i -e "8 bits per sample" -e "&gt;8bit" "$work/$i.err"; }
# More than 8 bits per color: macOS can write the image as a 16-bit PNG, which img2pdf
# embeds as is. Kept only when nothing is lost: one page, source at most 16 bits, PNG
# really 16 bits and not interlaced.
png16() {
  [ "$frames" = 1 ] || return 1
  # Whether sips turns the pixels, keeps the orientation tag or drops it is not known for
  # sure: an image above 8 bits that is not stored upright is refused rather than risked.
  o=$("$PY" -I -c 'import sys; from PIL import Image; print(Image.open(sys.argv[1]).getexif().get(274, 1))' "$1" 2&gt;/dev/null)
  [ "${o:-1}" = 1 ] || return 1
  bits=$(sips -g bitsPerSample "$1" 2&gt;/dev/null | awk '/bitsPerSample/ {print $2}')
  [ -n "$bits" ] &amp;&amp; [ "$bits" -le 16 ] || return 1
  sips -s format png "$1" --out "$work/$i.png" &gt;/dev/null 2&gt;&amp;1 || return 1
  read -r d _ _ _ l &lt;&lt;&lt;"$(od -An -tu1 -j24 -N5 "$work/$i.png")"
  [ "$d" = 16 ] &amp;&amp; [ "$l" = 0 ] || return 1
  "$IMG2PDF" --rotation=ifvalid --pillow-limit-break -o "$page" "$work/$i.png" 2&gt;"$work/$i.err"
}

work=$(mktemp -d) || fail "Dossier temporaire impossible à créer."
trap 'rm -rf "$work"' EXIT

parts=()
notes=""
expected=0
oldest_b=""
oldest_m=""
i=0
for f in "$@"; do
  i=$((i + 1))
  name=$(basename "$f")
  [ -d "$f" ] &amp;&amp; fail "« $name » est un dossier : sélectionne seulement des PDF et des images."
  [ -r "$f" ] || fail "Lecture impossible : $name"
  # Reading one byte makes macOS download a file kept only in iCloud; offline, it fails here.
  head -c 1 -- "$f" &gt;/dev/null 2&gt;&amp;1 ||
    fail "« $name » n'a pas pu être lu. S'il est dans iCloud, ouvre-le une fois pour le télécharger, puis recommence."

  # stat -L: a symlink's dates are those of the file it points to.
  m=$(stat -L -f %m -- "$f")
  b=$(stat -L -f %B -- "$f")
  [ -z "$b" ] || [ "$b" -le 0 ] &amp;&amp; b=$m # some volumes keep no creation date
  { [ -z "$oldest_m" ] || [ "$m" -lt "$oldest_m" ]; } &amp;&amp; oldest_m=$m
  { [ -z "$oldest_b" ] || [ "$b" -lt "$oldest_b" ]; } &amp;&amp; oldest_b=$b

  ext=$(printf '%s' "${name##*.}" | tr '[:upper:]' '[:lower:]')
  if [ "$ext" = "pdf" ] || [ "$(magic "$f")" = 25504446 ]; then
    n=$("$QPDF" --show-npages "$f" 2&gt;/dev/null)
    [ -n "$n" ] || fail "« $name » n'est pas un PDF lisible, ou il est protégé par un mot de passe."
    # A page-by-page merge keeps pages only: attached files (the XML of a Factur-X
    # invoice...) and layers are left behind, so say it and keep the original.
    "$QPDF" --list-attachments "$f" 2&gt;/dev/null | grep -q -v "has no embedded files" &amp;&amp;
      notes="$notes"$'\n'"« $name » : pièces jointes (facture Factur-X ?) non reprises, garde l'original"
    root=$("$QPDF" --show-object=trailer "$f" 2&gt;/dev/null | sed -n 's/.*\/Root \([0-9][0-9]*\) 0 R.*/\1/p')
    [ -n "$root" ] &amp;&amp; "$QPDF" --show-object="$root" "$f" 2&gt;/dev/null | grep -q "/OCProperties" &amp;&amp;
      notes="$notes"$'\n'"« $name » : calques, un calque masqué peut devenir visible"
    "$QPDF" --json --json-key=acroform "$f" 2&gt;/dev/null | grep -q '"fieldtype": "/Sig"' &amp;&amp;
      notes="$notes"$'\n'"« $name » : signature électronique, elle ne vaut plus dans le PDF assemblé, garde l'original"
    parts+=("$f")
  else
    page="$work/$i.pdf"
    # Common formats go straight to img2pdf, which embeds them as they are. Anything else
    # (HEIC, camera RAW...) is decoded by macOS into a lossless TIFF first: Pillow would
    # read only the small preview of a NEF or DNG, without any error.
    src="$f"
    case "$ext" in
      jpg | jpeg | jpe | jfif | png | gif | tif | tiff | bmp | webp | jp2 | j2k | jpf | jpx) ;;
      # No or unknown extension: a JPEG, PNG, GIF, BMP, WebP or JPEG 2000 is recognized by its
      # first bytes. A TIFF never is: camera RAW files (DNG, NEF...) are TIFF inside.
      *) case "$(magic "$f")" in ffd8ff* | 89504e47 | 47494638 | 424d* | 52494646 | 0000000c) ext=img ;; esac ;;
    esac
    case "$ext" in
      jpg | jpeg | jpe | jfif | png | gif | tif | tiff | bmp | webp | jp2 | j2k | jpf | jpx | img) ;;
      *)
        src="$work/$i.tiff"
        sips -s format tiff "$f" --out "$src" &gt;/dev/null 2&gt;&amp;1 ||
          fail "« $name » n'est ni un PDF ni une image lisible."
        ;;
    esac
    # An interlaced 16-bit PNG cannot be copied as is: img2pdf would decode it to 8 bits
    # without a word. It goes through the 16-bit PNG rewrite instead.
    frames=1
    if [ "$(magic "$f")" = 89504e47 ]; then
      read -r depth _ _ _ lace &lt;&lt;&lt;"$(od -An -tu1 -j24 -N5 "$f")"
      if [ "$depth" = "16" ] &amp;&amp; [ "$lace" = "1" ]; then
        png16 "$f" || fail "« $name » est un PNG 16 bits entrelacé : impossible de l'insérer sans perte."
        n=$("$QPDF" --show-npages "$page")
        parts+=("$page")
        expected=$((expected + n))
        continue
      fi
    fi
    # One page per photo: the extra frames of a JPEG (depth or gain map of a phone photo)
    # or of an animated GIF are dropped; a multipage TIFF scan keeps all its pages.
    # Pillow already turns a TIFF upright when it opens it: img2pdf must not turn it again.
    opt=(--first-frame-only)
    rot=--rotation=ifvalid
    srcs=()
    case "$(magic "$src")" in
      89504e47 | 47494638)
        # img2pdf writes the transparency mask of a small-palette PNG or GIF on 8 bits but
        # declares it with the palette's depth, which blanks the page, and drops the
        # transparent color of a 1-bit image: such an image is first expanded to RGBA,
        # which keeps every pixel, its resolution and its orientation.
        if "$PY" -I - "$src" "$work/$i-rgba.png" &lt;&lt;'PY' 2&gt;"$work/$i.err"; then
import sys
from PIL import Image
im = Image.open(sys.argv[1])
if im.mode not in ("P", "1", "L") or "transparency" not in im.info:
    sys.exit(1)
# Pillow scales a 2 or 4-bit gray PNG up to 8 bits but leaves its transparent value as
# stored: scaled here too, or no pixel would match it.
head = open(sys.argv[1], "rb").read(26)
if im.mode == "L" and head[:4] == b"\x89PNG" and head[24] in (2, 4):
    im.info["transparency"] *= 255 // (2 ** head[24] - 1)
keep = {k: im.info[k] for k in ("dpi", "exif") if im.info.get(k)}
im.convert("RGBA").save(sys.argv[2], **keep)
PY
          src="$work/$i-rgba.png"
        fi
        ;;
      49492a00 | 4d4d002a | 49492b00 | 4d4d002b) # TIFF, then BigTIFF
        opt=()
        rot=--rotation=none
        # Two kinds of turned TIFF page are turned here, one page per file, losslessly:
        # a fax-compressed (CCITT) one, which img2pdf copies undecoded so that Pillow's
        # turn would scramble it, and one turned a quarter with a different x and y
        # resolution, which img2pdf would size unswapped. Pages above 8 bits are left to
        # the 16-bit route below.
        frames=$("$PY" -I - "$src" "$work/$i-up" &lt;&lt;'PY' 2&gt;"$work/$i.err"
import sys
import io
from PIL import Image
src, out = sys.argv[1], sys.argv[2]
try:
    # Read from memory: from a path, Pillow maps an uncompressed TIFF page with its turned
    # size and scrambles it; img2pdf reads from memory too.
    im = Image.open(io.BytesIO(open(src, "rb").read()))
    n = getattr(im, "n_frames", 1)
    pages = []
    for k in range(n):
        im.seek(k)
        fax = im.mode == "1" and im.info.get("compression") in ("group3", "group4", "tiff_ccitt")
        bits = im.tag_v2.get(258, (8,))
        bits = max(bits) if isinstance(bits, tuple) else bits
        # Pillow reports (1, 1) for a scan with no resolution: left out, so img2pdf
        # uses its 96 dpi default as for any other TIFF.
        dpi = im.info.get("dpi")
        dpi = tuple(dpi) if dpi and tuple(dpi) != (1, 1) else None
        pages.append((fax, im.tag_v2.get(274, 1), bits, dpi))
except Exception:
    print(0)
    sys.exit(0)
quarter = (5, 6, 7, 8)
need = any((fax and o != 1) or (o in quarter and dpi and dpi[0] != dpi[1]) for fax, o, bits, dpi in pages)
if not need or any(bits &gt; 8 for fax, o, bits, dpi in pages):
    print(n)
    sys.exit(0)
for k, (fax, o, bits, dpi) in enumerate(pages):
    im.seek(k)
    im.load()
    extra = {"dpi": dpi[::-1] if o in quarter else dpi} if dpi else {}
    im.copy().save("%s-%05d.tiff" % (out, k), compression="group4" if fax else "tiff_adobe_deflate", **extra)
print(n, "turned")
PY
)
        case "$frames" in
          *turned)
            srcs=("$work/$i-up-"*.tiff)
            src=${srcs[0]}
            frames=${frames% turned}
            ;;
          "") fail "« $name » : scan TIFF impossible à redresser ($(tail -n 1 "$work/$i.err" | cut -c1-150))." ;;
        esac
        ;;
    esac
    [ ${#srcs[@]} -eq 0 ] &amp;&amp; srcs=("$src")
    # --pillow-limit-break: very large scans and panoramas are legitimate input.
    if ! "$IMG2PDF" "$rot" --pillow-limit-break "${opt[@]}" -o "$page" "${srcs[@]}" 2&gt;"$work/$i.err"; then
      if deep; then
        png16 "$src" || fail "« $name » a plus de 8 bits par couleur : impossible de l'insérer sans perte."
      # A misnamed file (a HEIC saved as .jpg...) gets a second chance through macOS.
      elif [ "$src" = "$f" ] &amp;&amp; sips -s format tiff "$f" --out "$work/$i.tiff" &gt;/dev/null 2&gt;&amp;1 &amp;&amp;
        "$IMG2PDF" --rotation=none --pillow-limit-break "${opt[@]}" -o "$page" "$work/$i.tiff" 2&gt;"$work/$i.err"; then
        :
      elif deep; then
        frames=1
        png16 "$work/$i.tiff" || fail "« $name » a plus de 8 bits par couleur : impossible de l'insérer sans perte."
      else
        fail "« $name » n'est pas une image lisible ($(tail -n 1 "$work/$i.err" | cut -c1-150))."
      fi
    fi
    # img2pdf cannot mirror an image: a mirrored EXIF orientation stays as stored.
    grep -q -i "flipped" "$work/$i.err" &amp;&amp; notes="$notes"$'\n'"« $name » : orientation en miroir non appliquée"
    n=$("$QPDF" --show-npages "$page")
    parts+=("$page")
  fi
  expected=$((expected + n))
done

# Same naming as Apple: "doc1.pdf", or "doc1 2.pdf", "doc1 3.pdf"... when taken.
dir=$(dirname "$1")
first=$(basename "$1")
stem="${first%.*}"
target="$dir/$stem.pdf"
k=2
while [ -e "$target" ]; do target="$dir/$stem $k.pdf"; k=$((k + 1)); done

# --stream-data=preserve: every stream is copied as is, never decoded nor recompressed.
# Exit code 3 means success with warnings (a slightly damaged source qpdf could read).
"$QPDF" --stream-data=preserve --empty --pages "${parts[@]}" -- "$work/merged.pdf" 2&gt;/dev/null
rc=$?
[ "$rc" -eq 0 ] || [ "$rc" -eq 3 ] || fail "L'assemblage a échoué (qpdf, code $rc)."

# Internal dates: a new /Info object added through qpdf's JSON update. The trailer is
# replaced as written, so it carries /Root and /Size too.
pdfdate() {
  local s
  s=$(date -r "$1" +%Y%m%d%H%M%S%z)
  printf "D:%s%s'%s'" "${s:0:14}" "${s:14:3}" "${s:17:2}"
}
trailer=$("$QPDF" --show-object=trailer "$work/merged.pdf" 2&gt;/dev/null)
root=$(printf '%s' "$trailer" | sed -n 's/.*\/Root \([0-9][0-9]*\) 0 R.*/\1/p')
size=$(printf '%s' "$trailer" | sed -n 's/.*\/Size \([0-9][0-9]*\).*/\1/p')
[ -n "$root" ] &amp;&amp; [ -n "$size" ] || fail "Structure du PDF assemblé inattendue."
cdate=$(pdfdate "$oldest_b")
mdate=$(pdfdate "$oldest_m")
cat &gt;"$work/info.json" &lt;&lt;EOF
{"qpdf":[{"jsonversion":2,"pushedinheritedpageresources":false,"calledgetallpages":false,"maxobjectid":$((size - 1))},
{"obj:$size 0 R":{"value":{"/CreationDate":"u:$cdate","/ModDate":"u:$mdate"}},
"trailer":{"value":{"/Root":"$root 0 R","/Info":"$size 0 R","/Size":$((size + 1))}}}]}
EOF
"$QPDF" --stream-data=preserve "$work/merged.pdf" --update-from-json="$work/info.json" "$work/final.pdf" 2&gt;/dev/null
rc=$?
[ "$rc" -eq 0 ] || [ "$rc" -eq 3 ] || fail "Écriture des dates internes impossible (qpdf, code $rc)."

# Never pass on a PDF that lost pages on the way.
got=$("$QPDF" --show-npages "$work/final.pdf" 2&gt;/dev/null)
[ "$got" = "$expected" ] || fail "Des pages se sont perdues pendant l'assemblage ($got sur $expected)."

# -n never overwrites: if the same name appeared meanwhile (the action run twice at once),
# the PDF is still here and nothing is claimed.
mv -n -- "$work/final.pdf" "$target" 2&gt;/dev/null &amp;&amp; [ ! -e "$work/final.pdf" ] ||
  fail "Écriture impossible dans $dir (dossier protégé, ou action lancée deux fois en même temps)."

# File dates: modification first, creation last, because lowering the modification date
# below the creation date drags the creation date down with it.
osascript -l JavaScript - "$target" "$oldest_m" "$oldest_b" &lt;&lt;'JXA' &gt;/dev/null
function run(argv) {
  ObjC.import('Foundation');
  const fm = $.NSFileManager.defaultManager;
  const at = (s) =&gt; $.NSDate.dateWithTimeIntervalSince1970(Number(s));
  fm.setAttributesOfItemAtPathError($.NSDictionary.dictionaryWithObjectForKey(at(argv[1]), 'NSFileModificationDate'), argv[0], null);
  fm.setAttributesOfItemAtPathError($.NSDictionary.dictionaryWithObjectForKey(at(argv[2]), 'NSFileCreationDate'), argv[0], null);
}
JXA

# Read every date back: a refused change must not pass silently.
missed=""
[ "$(stat -L -f %B -- "$target")" = "$oldest_b" ] || missed="$missed"$'\n'"création (Finder)"
[ "$(stat -L -f %m -- "$target")" = "$oldest_m" ] || missed="$missed"$'\n'"modification (Finder)"
info=$("$QPDF" --show-object=trailer "$target" 2&gt;/dev/null | sed -n 's/.*\/Info \([0-9][0-9]*\) 0 R.*/\1/p')
infodict=$([ -n "$info" ] &amp;&amp; "$QPDF" --show-object="$info" "$target" 2&gt;/dev/null)
case "$infodict" in *"/CreationDate ($cdate)"*) ;; *) missed="$missed"$'\n'"création (interne au PDF)" ;; esac
case "$infodict" in *"/ModDate ($mdate)"*) ;; *) missed="$missed"$'\n'"modification (interne au PDF)" ;; esac
msg=""
[ -z "$missed" ] || msg="ces dates n'ont pas pu être recalées :$missed"
if [ -n "$notes" ]; then
  [ -z "$msg" ] || msg="$msg"$'\n\n'
  msg="${msg}à vérifier :$notes"
fi
[ -z "$msg" ] || warn "« $(basename "$target") » est créé, mais $msg"
exit 0
</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/bash</string>
					<key>source</key>
					<string></string>
				</dict>
				<key>BundleIdentifier</key>
				<string>com.apple.RunShellScript</string>
				<key>CFBundleVersion</key>
				<string>2.0.3</string>
				<key>CanShowSelectedItemsWhenRun</key>
				<false/>
				<key>CanShowWhenRun</key>
				<true/>
				<key>Category</key>
				<array>
					<string>AMCategoryUtilities</string>
				</array>
				<key>Class Name</key>
				<string>RunShellScriptAction</string>
				<key>InputUUID</key>
				<string>159B2136-1735-402C-8063-53C33E72829A</string>
				<key>Keywords</key>
				<array>
					<string>Shell</string>
					<string>Script</string>
					<string>Command</string>
					<string>Run</string>
					<string>Unix</string>
				</array>
				<key>OutputUUID</key>
				<string>29E6F044-3BE2-4C47-A109-AA6BA4CFA2C0</string>
				<key>UUID</key>
				<string>F36D20A9-7AB7-4E41-880F-4E99514CE2F8</string>
				<key>UnlocalizedApplications</key>
				<array>
					<string>Automator</string>
				</array>
				<key>arguments</key>
				<dict>
					<key>0</key>
					<dict>
						<key>default value</key>
						<integer>0</integer>
						<key>name</key>
						<string>inputMethod</string>
						<key>required</key>
						<string>0</string>
						<key>type</key>
						<string>0</string>
						<key>uuid</key>
						<string>0</string>
					</dict>
					<key>1</key>
					<dict>
						<key>default value</key>
						<false/>
						<key>name</key>
						<string>CheckedForUserDefaultShell</string>
						<key>required</key>
						<string>0</string>
						<key>type</key>
						<string>0</string>
						<key>uuid</key>
						<string>1</string>
					</dict>
					<key>2</key>
					<dict>
						<key>default value</key>
						<string></string>
						<key>name</key>
						<string>source</string>
						<key>required</key>
						<string>0</string>
						<key>type</key>
						<string>0</string>
						<key>uuid</key>
						<string>2</string>
					</dict>
					<key>3</key>
					<dict>
						<key>default value</key>
						<string></string>
						<key>name</key>
						<string>COMMAND_STRING</string>
						<key>required</key>
						<string>0</string>
						<key>type</key>
						<string>0</string>
						<key>uuid</key>
						<string>3</string>
					</dict>
					<key>4</key>
					<dict>
						<key>default value</key>
						<string>/bin/sh</string>
						<key>name</key>
						<string>shell</string>
						<key>required</key>
						<string>0</string>
						<key>type</key>
						<string>0</string>
						<key>uuid</key>
						<string>4</string>
					</dict>
				</dict>
				<key>isViewVisible</key>
				<integer>1</integer>
				<key>location</key>
				<string>544.000000:305.000000</string>
				<key>nibPath</key>
				<string>/System/Library/Automator/Run Shell Script.action/Contents/Resources/Base.lproj/main.nib</string>
			</dict>
			<key>isViewVisible</key>
			<integer>1</integer>
		</dict>
	</array>
	<key>connectors</key>
	<dict/>
	<key>workflowMetaData</key>
	<dict>
		<key>applicationBundleID</key>
		<string>com.apple.finder</string>
		<key>applicationBundleIDsByPath</key>
		<dict>
			<key>/System/Library/CoreServices/Finder.app</key>
			<string>com.apple.finder</string>
		</dict>
		<key>applicationPath</key>
		<string>/System/Library/CoreServices/Finder.app</string>
		<key>applicationPaths</key>
		<array>
			<string>/System/Library/CoreServices/Finder.app</string>
