<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AMApplicationBuild</key>
	<string>534</string>
	<key>AMApplicationVersion</key>
	<string>2.10</string>
	<key>AMDocumentVersion</key>
	<string>2</string>
	<key>actions</key>
	<array>
		<dict>
			<key>action</key>
			<dict>
				<key>AMAccepts</key>
				<dict>
					<key>Container</key>
					<string>List</string>
					<key>Optional</key>
					<true/>
					<key>Types</key>
					<array>
						<string>com.apple.cocoa.string</string>
					</array>
				</dict>
				<key>AMActionVersion</key>
				<string>2.0.3</string>
				<key>AMApplication</key>
				<array>
					<string>Automator</string>
				</array>
				<key>AMParameterProperties</key>
				<dict>
					<key>COMMAND_STRING</key>
					<dict/>
					<key>CheckedForUserDefaultShell</key>
					<dict/>
					<key>inputMethod</key>
					<dict/>
					<key>shell</key>
					<dict/>
					<key>source</key>
					<dict/>
				</dict>
				<key>AMProvides</key>
				<dict>
					<key>Container</key>
					<string>List</string>
					<key>Types</key>
					<array>
						<string>com.apple.cocoa.string</string>
					</array>
				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/bash
# Finder Quick Action "Créer un PDF": Apple's Create PDF, lossless and dated.
# The selected PDFs and images, in click order, become one PDF next to the first file,
# named like Apple ("doc1 2.pdf"). PDF pages are copied byte for byte; every image page is
# compared with its source before use, and an image that cannot be proven identical is
# refused. The result carries the oldest creation date and the oldest modification date
# found among the sources (Finder dates, photo capture date, dates written inside a PDF).
# The work runs in img2pdf's own Python, which holds img2pdf, Pillow and pikepdf.
export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
for t in img2pdf qpdf exiftool; do
  if [ ! -x "/opt/homebrew/bin/$t" ]; then
    osascript -e 'on run argv' -e activate -e 'display dialog (item 1 of argv) buttons {"OK"} default button "OK" with icon caution with title "Créer un PDF"' \
      -e 'end run' "$t est introuvable. Dans le Terminal : brew install $t"$'\n\nAucun PDF créé.' &gt;/dev/null
    exit 0
  fi
done
PY=$(sed -n '1s/^#! *//p' /opt/homebrew/bin/img2pdf)
exec "$PY" -I - "$@" &lt;&lt;'PY'
import io, json, logging, os, re, shutil, subprocess, sys, tempfile, time
from datetime import datetime, timedelta, timezone
import img2pdf, math, pikepdf
from PIL import Image, ImageChops, ImageOps, ImageStat

QPDF = "/opt/homebrew/bin/qpdf"
EXIFTOOL = "/opt/homebrew/bin/exiftool"


def dialog(text):
    subprocess.run(["osascript", "-e", "on run argv", "-e", "activate", "-e",
                    'display dialog (item 1 of argv) buttons {"OK"} default button "OK" '
                    'with icon caution with title "Créer un PDF"', "-e", "end run", text],
                   capture_output=True)


class Refused(Exception):
    pass


def refuse(text):
    raise Refused(text)


Image.MAX_IMAGE_PIXELS = None  # big scans and panoramas are legitimate input
logging.disable(logging.WARNING)
ANGLE = {1: 0, 3: 180, 6: 90, 8: 270}  # EXIF orientation -&gt; clockwise page rotation
A4_WIDTH = 595.276  # points


def a4_wide(turned):
    """img2pdf layout: once displayed, every image page is as wide as an A4 sheet and as tall as
    the image's proportions say (Michael 2026-10-25). Only the page size changes, never a pixel."""
    def layout(w, h, dpi):  # w, h: the image as stored, before the page turns it
        w, h = w / dpi[0], h / dpi[1]  # a fax has taller than wide dots (204 x 98 dpi)
        pw, ph = (A4_WIDTH * w / h, A4_WIDTH) if turned else (A4_WIDTH, A4_WIDTH * h / w)
        return pw, ph, pw, ph
    return layout
notes, made = [], []


def kind(path):
    with open(path, "rb") as f:
        m = f.read(12)
    ext = os.path.splitext(path)[1].lower()
    if m.startswith(b"%PDF") or ext == ".pdf":
        return "pdf"
    if m.startswith(b"\xff\xd8\xff"):
        return "jpeg"
    if m.startswith(b"\x89PNG\r\n\x1a\n"):
        return "png"
    if m.startswith((b"GIF8", b"BM")) or (m[:4] == b"RIFF" and m[8:12] == b"WEBP"):
        return "pillow"
    # Camera RAW files are TIFF inside: Pillow would read only their small preview.
    if m[:4] in (b"II*\x00", b"MM\x00*") and ext in (".tif", ".tiff"):
        return "tiff"
    return "macos"  # HEIC, AVIF, RAW...: decoded by macOS itself


def add_pdf(path, name):
    try:
        pdf = pikepdf.open(path)
    except pikepdf.PasswordError:
        refuse(f"« {name} » est protégé par un mot de passe.")
    except Exception:
        refuse(f"« {name} » n'est pas un PDF lisible.")
    with pdf:
        # A page-by-page merge keeps pages only.
        if len(pdf.attachments):
            notes.append(f"« {name} » : pièces jointes (facture Factur-X ?) non reprises, garde l'original")
        if "/OCProperties" in pdf.Root:
            notes.append(f"« {name} » : calques, un calque masqué peut devenir visible, garde l'original")
        form = pdf.Root.get("/AcroForm")
        fields = list(form.get("/Fields", [])) if form is not None else []
        while fields:
            f = fields.pop()
            if f.get("/FT") == "/Sig" and "/V" in f:
                notes.append(f"« {name} » : signature électronique, elle ne vaut plus dans le PDF assemblé, garde l'original")
                break
            fields.extend(f.get("/Kids", []))
        return len(pdf.pages)


def bits(path, k, im):
    """Bits per color sample of the file itself (Pillow silently reads 16-bit RGB as 8)."""
    if k == "png":
        with open(path, "rb") as f:
            return f.read(25)[24]
    if k == "tiff":
        b = im.tag_v2.get(258, (8,))
        return max(b) if isinstance(b, tuple) else b
    return 8


def idat(path):
    with open(path, "rb") as f:
        data, out = f.read(), []
    pos = 8
    while pos &lt; len(data):
        n = int.from_bytes(data[pos:pos + 4], "big")
        if data[pos + 4:pos + 8] == b"IDAT":
            out.append(data[pos + 8:pos + 8 + n])
        pos += 12 + n
    return b"".join(out), data[16:29]


def icc_of(x):
    cs = x.get("/ColorSpace")
    if isinstance(cs, pikepdf.Array) and cs[0] == "/Indexed":
        cs = cs[1]
    if isinstance(cs, pikepdf.Array) and cs[0] == "/ICCBased":
        return cs[1].read_bytes()
    return None


def displayed(x, rot):
    got = pikepdf.PdfImage(x).as_pil_image()
    if "/SMask" in x and got.mode not in ("RGBA", "LA"):
        got = got.convert("RGBA")
        got.putalpha(pikepdf.PdfImage(x.SMask).as_pil_image().convert("L"))
    turn = {90: Image.Transpose.ROTATE_270, 180: Image.Transpose.ROTATE_180, 270: Image.Transpose.ROTATE_90}
    return got.transpose(turn[rot]) if rot else got


def same_pixels(a, b):
    if a.size != b.size:
        return False
    if a.mode == b.mode and a.mode not in ("P", "PA"):
        return a.tobytes() == b.tobytes()
    alpha = any(i.mode in ("RGBA", "LA", "PA") or "transparency" in i.info for i in (a, b))
    mode = "RGBA" if alpha else "RGB"
    return a.convert(mode).tobytes() == b.convert(mode).tobytes()


def identical(pdfbytes, path, k, im, frames, deep):
    """True when every page shows exactly its source frame, upright, with its color profile."""
    with pikepdf.open(io.BytesIO(pdfbytes)) as pdf:
        if len(pdf.pages) != frames:
            return False
        for j, page in enumerate(pdf.pages):
            xobjects = (page.obj.get("/Resources") or {}).get("/XObject") or {}
            xs = [v for _, v in xobjects.items() if v.get("/Subtype") == "/Image"]
            if len(xs) != 1:
                return False
            x = xs[0]
            rot = int(page.obj.get("/Rotate", 0)) % 360
            im.seek(j)
            icc = im.info.get("icc_profile")
            if icc and icc_of(x) != icc:
                return False
            if k == "jpeg" or deep:
                # Stored as is: the bytes must be the source's, turned by the page only.
                if rot != ANGLE.get(im.getexif().get(274, 1)):
                    return False
                raw = x.read_raw_bytes()
                if k == "jpeg":
                    with open(path, "rb") as f:
                        src = f.read()
                    # A phone JPEG may carry extra images (gain map...): only the first one is kept.
                    if not (raw == src or (src.startswith(raw) and raw.endswith(b"\xff\xd9"))):
                        return False
                else:
                    # A 16-bit PNG: its compressed rows must be copied untouched.
                    data, ihdr = idat(path)
                    width, depth, ctype, interlace = int.from_bytes(ihdr[0:4], "big"), ihdr[8], ihdr[9], ihdr[12]
                    parms = x.get("/DecodeParms", {})
                    if (raw != data or interlace or ctype not in (0, 2) or "/SMask" in x
                            or x.BitsPerComponent != depth or parms.get("/Predictor") != 15
                            or parms.get("/Columns") != width or parms.get("/Colors") != (1 if ctype == 0 else 3)):
                        return False
                continue
            if not same_pixels(displayed(x, rot), ImageOps.exif_transpose(im)):
                return False
    return True


def add_image(path, name, k, i, work):
    if k == "macos":
        src = os.path.join(work, f"{i}.png")
        r = subprocess.run(["sips", "-s", "format", "png", path, "--out", src], capture_output=True)
        if r.returncode or not os.path.isfile(src):
            refuse(f"« {name} » n'est ni un PDF ni une image lisible.")
        path, k = src, "png"
        # Michael 2026-10-25: a HEIC (or AVIF, RAW) becomes a JPEG of quality 98, half the size of
        # its lossless pixels and no visible loss; only images with transparency stay lossless.
        try:
            up = ImageOps.exif_transpose(Image.open(path))
            if up.mode in ("RGB", "L"):
                jpg = os.path.join(work, f"{i}.jpg")
                keep = {"icc_profile": up.info["icc_profile"]} if up.info.get("icc_profile") else {}
                up.save(jpg, quality=98, subsampling=0, **keep)
                # The JPEG must stay close to the decoded photo: quality 98 measures 43 to 57 dB.
                with Image.open(jpg) as back:
                    mse = sum(v * v for v in ImageStat.Stat(ImageChops.difference(up, back)).rms) / len(up.getbands())
                if mse and 10 * math.log10(255 ** 2 / mse) &lt; 40:
                    refuse(f"« {name} » ne peut pas être converti fidèlement en JPEG.")
                path, k = jpg, "jpeg"
        except Refused:
            raise
        except Exception:
            pass  # unreadable here: the lossless way below says why
    try:
        im = Image.open(path)
        frames = getattr(im, "n_frames", 1) if k == "tiff" else 1  # a scan keeps its pages, a photo gives one
        deep = bits(path, k, im) &gt; 8
    except Exception:
        refuse(f"« {name} » n'est pas une image lisible.")
    if deep and k != "png":
        refuse(f"« {name} » a plus de 8 bits par couleur et ne peut pas être inséré sans perte.")
    # First way: img2pdf stores the file as it is (JPEG and most PNG untouched).
    try:
        turned = ANGLE.get(im.getexif().get(274, 1)) in (90, 270)
        pdf = img2pdf.convert(path, rotation=img2pdf.Rotation.ifvalid, first_frame_only=(k != "tiff"),
                              layout_fun=a4_wide(turned))
        if identical(pdf, path, k, im, frames, deep):
            return pdf, frames
    except Exception:
        pass
    if deep:
        refuse(f"« {name} » a plus de 8 bits par couleur et ne peut pas être inséré sans perte.")
    # Second way: decode, turn upright, store every pixel losslessly as PNG.
    try:
        pngs = []
        for j in range(frames):
            im.seek(j)
            fr = ImageOps.exif_transpose(im)
            if fr.mode in ("P", "PA"):
                fr = fr.convert("RGBA" if fr.mode == "PA" or "transparency" in fr.info else "RGB")
            if fr.mode not in ("1", "L", "LA", "RGB", "RGBA"):
                raise ValueError(fr.mode)  # CMYK, 32-bit...: no lossless PNG for them
            keep = {key: im.info[key] for key in ("icc_profile", "dpi") if im.info.get(key)}
            pngs.append(os.path.join(work, f"{i}-{j}.png"))
            fr.save(pngs[-1], **keep)
        pdf = img2pdf.convert(pngs, rotation=img2pdf.Rotation.none, layout_fun=a4_wide(False))
        why = "" if identical(pdf, path, "decoded", im, frames, False) else "pages différentes de l'image"
    except Exception as e:
        why = f"{type(e).__name__} : {e}"
    if why:
        refuse(f"« {name} » ne peut pas être inséré à l'identique ({why}).")
    return pdf, frames


def parse(text, offset=None, since=1900):
    m = re.match(r"(\d{4}):(\d\d):(\d\d) (\d\d):(\d\d)(?::(\d\d))?(Z|[+-]\d\d:?\d\d)?", str(text or ""))  # exiftool -n gives a bare number for "2019"
    if not m:
        return None
    try:
        d = datetime(*(int(v or 0) for v in m.groups()[:6]))
    except ValueError:
        return None  # "0000:00:00 00:00:00" and the like
    if d.year &lt; since:
        return None  # a software default (0001, 1601, 1904, 1970), not a real date
    tz = m.group(7) or offset
    if tz:
        if tz == "Z":
            return d.replace(tzinfo=timezone.utc).timestamp()
        t = tz.replace(":", "")
        delta = timedelta(hours=int(t[1:3]), minutes=int(t[3:5]))
        return d.replace(tzinfo=timezone(delta if t[0] == "+" else -delta)).timestamp()
    return time.mktime(d.timetuple())  # no time zone: the Mac's own


def oldest_dates(files):
    created, modified = [], []
    for f in files:
        st = os.stat(f)
        b = getattr(st, "st_birthtime", 0)
        created.append(b if b &gt; 0 else st.st_mtime)  # some volumes keep no creation date
        modified.append(st.st_mtime)
    r = subprocess.run([EXIFTOOL, "-j", "-q", "-q", "-n", "-DateTimeOriginal", "-OffsetTimeOriginal",
                        "-PDF:CreateDate", "-PDF:ModifyDate", *files], capture_output=True, text=True)
    try:
        if r.returncode:
            raise ValueError
        for rec in json.loads(r.stdout):
            # PDF dates before 1993, the year PDF was born, are software defaults.
            for t in (parse(rec.get("DateTimeOriginal"), rec.get("OffsetTimeOriginal")), parse(rec.get("CreateDate"), since=1993)):
                if t:
                    created.append(t)
            t = parse(rec.get("ModifyDate"), since=1993)
            if t:
                modified.append(t)
    except ValueError:
        notes.append("dates de prise de vue ou dates internes d'un PDF illisibles : la date retenue peut être trop récente")
    return int(min(created)), int(min(modified))


def pdfdate(t):
    d = datetime.fromtimestamp(t).astimezone()
    z = d.strftime("%z")
    return d.strftime("D:%Y%m%d%H%M%S") + f"{z[:3]}'{z[3:]}'"


def run(files, work):
    parts, expected = [], 0
    for i, f in enumerate(files, 1):
        name = os.path.basename(f)
        if os.path.isdir(f):
            refuse(f"« {name} » est un dossier : sélectionne seulement des PDF et des images.")
        try:
            k = kind(f)  # reading makes macOS download a file kept only in iCloud
        except OSError:
            refuse(f"« {name} » n'a pas pu être lu. S'il est dans iCloud, ouvre-le une fois pour le télécharger, puis recommence.")
        if k == "pdf":
            expected += add_pdf(f, name)
            parts.append(f)
        else:
            pdf, n = add_image(f, name, k, i, work)
            expected += n
            parts.append(os.path.join(work, f"{i}.pdf"))
            with open(parts[-1], "wb") as out:
                out.write(pdf)

    created, modified = oldest_dates(files)
    merged = os.path.join(work, "merged.pdf")
    # --stream-data=preserve: every stream is copied as is, never decoded nor recompressed.
    r = subprocess.run([QPDF, "--stream-data=preserve", "--empty", "--pages", *parts, "--", merged],
                       capture_output=True, text=True)
    if r.returncode not in (0, 3):
        refuse(f"L'assemblage a échoué (qpdf : {r.stderr.strip()[-150:]}).")
    if r.returncode == 3 or "WARNING" in r.stderr:  # qpdf names the damaged file in each warning
        bad = [os.path.basename(f) for f, part in zip(files, parts) if part + ":" in r.stderr or part + " (" in r.stderr]
        bad = bad or ["un PDF source"]
        notes.extend(f"« {n} » était abîmé et a été réparé au passage : vérifie ses pages dans le PDF créé" for n in bad)
    final = os.path.join(work, "final.pdf")
    with pikepdf.open(merged) as pdf:
        if len(pdf.pages) != expected:
            refuse(f"Des pages se sont perdues pendant l'assemblage ({len(pdf.pages)} sur {expected}).")
        pdf.docinfo["/CreationDate"] = pdfdate(created)
        pdf.docinfo["/ModDate"] = pdfdate(modified)
        pdf.save(final, compress_streams=False, stream_decode_level=pikepdf.StreamDecodeLevel.none)

    # Same naming as Apple: "doc1.pdf", or "doc1 2.pdf", "doc1 3.pdf"... when taken. Creating
    # the file exclusively claims the name, even if the action runs twice at once.
    folder = os.path.dirname(files[0])
    stem = os.path.splitext(os.path.basename(files[0]))[0]
    n = 1
    while True:
        target = os.path.join(folder, f"{stem}.pdf" if n == 1 else f"{stem} {n}.pdf")
        try:
            out = open(target, "xb")
            break
        except FileExistsError:
            n += 1
        except OSError:
            refuse(f"Impossible d'écrire dans « {folder} » (dossier protégé ou disque en lecture seule).")
    try:
        with out, open(final, "rb") as src:
            shutil.copyfileobj(src, out)
    except OSError:
        os.remove(target)
        refuse(f"Écriture impossible dans « {folder} » (disque plein ?).")
    made.append(target)

    # File dates: modification first, creation last, because lowering the modification date
    # below the creation date drags the creation date down with it.
    subprocess.run(["osascript", "-l", "JavaScript", "-e", """function run(argv) {
  ObjC.import('Foundation');
  const fm = $.NSFileManager.defaultManager;
  const at = (s) =&gt; $.NSDate.dateWithTimeIntervalSince1970(Number(s));
  fm.setAttributesOfItemAtPathError($.NSDictionary.dictionaryWithObjectForKey(at(argv[1]), 'NSFileModificationDate'), argv[0], null);
  fm.setAttributesOfItemAtPathError($.NSDictionary.dictionaryWithObjectForKey(at(argv[2]), 'NSFileCreationDate'), argv[0], null);
}""", target, str(modified), str(created)], capture_output=True)
    st = os.stat(target)
    if int(getattr(st, "st_birthtime", -1)) != created:
        notes.append("la date de création du fichier n'a pas pu être recalée")
    if int(st.st_mtime) != modified:
        notes.append("la date de modification du fichier n'a pas pu être recalée")
    if notes:
        dialog(f"« {os.path.basename(target)} » est créé, mais à vérifier :\n" + "\n".join(notes))


files = sys.argv[1:]
if files:
    work = tempfile.mkdtemp()
    try:
        run(files, work)
    except Refused as e:
        dialog(f"{e}\n\nAucun PDF créé.")
    except Exception as e:  # a bug or a library change: say what broke instead of failing silently
        why = f"erreur inattendue ({type(e).__name__} : {e})"
        dialog(f"« {os.path.basename(made[0])} » est créé, mais à vérifier : {why}" if made else f"Créer un PDF : {why}.\n\nAucun PDF créé.")
    finally:
        shutil.rmtree(work, ignore_errors=True)
PY
